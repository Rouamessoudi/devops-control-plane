# Development template. Copy to .env and replace every dev-only value before any shared or production use.
# Never commit .env.

MYSQL_ROOT_PASSWORD=dev-only-mysql-root
MYSQL_PASSWORD=dev-only-mysql-password

# At least 32 characters. Production must not use a dev-only prefix.
JWT_SECRET=dev-only-jwt-secret-change-me-32b
INTERNAL_SERVICE_TOKEN=dev-only-internal-token-change-me

# SHA-256 of this string encrypts application environment variables at rest.
ENV_ENCRYPTION_KEY=dev-only-env-key-change-me

# Optional. Leave empty until a cluster and a GitHub repository are available.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
DCP_REGISTRY=
DCP_ALLOWED_GITHUB_ORGS=
DCP_ENFORCE_GITHUB_ALLOWLIST=false

# Local admin created once when no ADMIN user exists.
DCP_ADMIN_EMAIL=admin@dcp.local
DCP_ADMIN_PASSWORD=ChangeMe!2026

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-admin
