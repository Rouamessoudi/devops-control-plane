{
  "uid": "dcp-overview",
  "title": "DevOps Control Plane",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU processus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (process_cpu_usage{job=\"devops-control-plane\"})" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mémoire JVM (heap)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{job=\"devops-control-plane\",area=\"heap\"})" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requêtes HTTP / s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"devops-control-plane\"}[5m]))" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latence HTTP moyenne",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_sum{job=\"devops-control-plane\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{job=\"devops-control-plane\"}[5m]))" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs HTTP 5xx / s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"devops-control-plane\",status=~\"5..\"}[5m]))" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Santé des services (up)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"devops-control-plane\"} == 1)" }]
    }
  ]
}
